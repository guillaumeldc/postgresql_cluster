# Please specify the ip addresses and connection settings for your environment
# The specified ip addresses will be used to listen by the cluster components.
# Attention! Specify private IP addresses so that the cluster does not listen a public IP addresses.
# For deploying via public IPs, add 'ansible_host=public_ip_address' variable for each node.

# "postgresql_exists='true'" if PostgreSQL is already exists and running
# "hostname=" variable is optional (used to change the server name)
# "new_node=true" to add a new server to an existing cluster using the add_pgnode.yml playbook

# In this example, all components will be installed on PostgreSQL nodes.
# You can deploy the haproxy balancers and the etcd or consul cluster on other dedicated servers (recomended).

# if dcs_exists: false and dcs_type: "etcd"
[etcd_cluster]  # recommendation: 3, or 5-7 nodes
; 10.64.48.95
; 10.64.48.96
; 10.64.48.97
; 98.188.24.42
; 10.8.162.100
; 10.8.162.101
; 10.8.162.102

# if dcs_exists: false and dcs_type: "consul"
[consul_instances]
# ─── DC‑1 DUKE ─────────────────────────────────────────────
; 10.64.48.95 consul_node_role=server consul_bootstrap_expect=true consul_datacenter=dc1
; 10.64.48.96 consul_node_role=server consul_bootstrap_expect=true consul_datacenter=dc1
; 10.64.48.97 consul_node_role=server consul_bootstrap_expect=true consul_datacenter=dc1

; # ─── DC‑2 (WAN segment) ──────────────────────────────
10.8.162.100 consul_node_role=server consul_bootstrap_expect=3 consul_datacenter=dc2
10.8.162.101 consul_node_role=server consul_bootstrap_expect=3 consul_datacenter=dc2
10.8.162.102 consul_node_role=server consul_bootstrap_expect=3 consul_datacenter=dc2

; # ─── DC‑3 (WAN segment) ──────────────────────────────
; 10.29.29.201 consul_node_role=server consul_bootstrap_expect=7 consul_datacenter=dc3


# Optional clients / app hosts

[balancers]
; 10.64.48.95 balancer_tags="datacenter=dc1"
; 10.64.48.96 balancer_tags="datacenter=dc1"
; 10.64.48.97 balancer_tags="datacenter=dc1"
10.8.162.100 balancer_tags="datacenter=dc2"
10.8.162.101 balancer_tags="datacenter=dc2"
10.8.162.102 balancer_tags="datacenter=dc2"
; 10.29.29.201 balancer_tags="datacenter=dc3" datacenter=dc3

# PostgreSQL nodes
[master]
# ─── DC‑1 : leader ──────────────────────────────
; 10.64.48.95 hostname=DUKEPDPS41 postgresql_exists=false patroni_tags="datacenter=dc1,failover_priority=90"
# ─── DC‑2 : leader ──────────────────────────────
10.8.162.100 hostname=DVTCPDPS28 postgresql_exists=true patroni_tags="datacenter=dc2,failover_priority=90"
[replica]
; 10.64.48.96 hostname=DUKEPDPS42 postgresql_exists=true patroni_tags="datacenter=dc1,failover_priority=80"
; 10.64.48.97 hostname=DUKEPDPS43 postgresql_exists=true patroni_tags="datacenter=dc1,failover_priority=70"

; # ─── DC‑2 : async replicas only (no WAN latency on commits) ───────
10.8.162.101 hostname=DVTCPDPS29 postgresql_exists=true patroni_tags="datacenter=dc2,failover_priority=80"
10.8.162.102 hostname=DVTCPDPS30 postgresql_exists=true patroni_tags="datacenter=dc2,failover_priority=70"
; # DC-3
; 10.29.29.201 hostname=DVTCPDPS31 postgresql_exists=true patroni_tags="datacenter=dc3,nosync=true,failover_priority=10" datacenter=dc3

[postgres_cluster:children]
master
replica

